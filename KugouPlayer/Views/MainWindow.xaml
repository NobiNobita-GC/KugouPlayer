<Window x:Class="KugouPlayer.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" 
        Title="酷狗音乐" 
        d:DesignWidth="1050" d:DesignHeight="1000"
        Height="750" Width="1050" 
        MinHeight="600" MinWidth="900" 
WindowStyle="None" ResizeMode="CanResize" Background="white">
    <WindowChrome.WindowChrome>
        <WindowChrome NonClientFrameEdges="None" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="*" />
            <RowDefinition Height="75" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <!-- 第一列：Logo区域 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Assets/酷狗音乐.png" Width="32" Height="32" Stretch="Uniform" />
                <TextBlock Text="酷狗音乐" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#222222" />
            </StackPanel>
            <!-- 第二列：搜索区域 -->
            <Border Grid.Column="1" Width="400" Height="36" Margin="30 0 0 0" Background="#f5f5f5" CornerRadius="18" HorizontalAlignment="Left">
                <Grid>
                    <!-- 搜索图标 -->
                    <TextBlock Text="🔍" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0" />
                    <!-- 搜索输入框 -->
                    <TextBox x:Name="SearchTextBox" Margin="42,0,10,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" Foreground="#333333" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="搜索歌曲、歌手、专辑" Margin="42,0,10,0" VerticalAlignment="Center" Foreground="#999999" FontSize="13" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!--默认显示-->
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <!--有输入隐藏-->
                                    <DataTrigger Binding="{Binding IsSearchEmpty}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style></TextBlock>
                </Grid>
            </Border>
            <!-- 第三列：用户区域 -->
            <!-- 第四列：窗口按钮区域 -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Width="40" Height="40" Background="Transparent" BorderThickness="0" Padding="0" Click="MinimizeButton_Click">
                    <Rectangle Width="12" Height="1" Fill="#666666" />
                </Button>
                <Button Width="40" Height="40" Background="Transparent" BorderThickness="0" Padding="0" Click="MaximizeButton_Click">
                    <Rectangle Width="12" Height="12" Stroke="#666666" StrokeThickness="1" Fill="Transparent" />
                </Button>
                <Button Width="40" Height="40" Background="Transparent" BorderThickness="0" Padding="0" Click="CloseButton_Click">
                    <Grid Width="12" Height="12">
                        <Line X1="1" Y1="1" X2="11" Y2="11" Stroke="#666666" StrokeThickness="1.2" />
                        <Line X1="11" Y1="1" X2="1" Y2="11" Stroke="#666666" StrokeThickness="1.2" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="#F7F7F7">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,20,12,20">
                        <!-- 首页 -->
                        <Border Height="44" CornerRadius="7" Background="#FFEAF2" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 图标 -->
                                <TextBlock Grid.Column="0" Text="⌂" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="#333333" />
                                <!-- 文字 -->
                                <TextBlock Grid.Column="1" Text="首页" VerticalAlignment="Center" FontSize="14" Foreground="#222222" />
                            </Grid>
                        </Border>
                        <!-- 推荐 -->
                        <Border Height="44" CornerRadius="7" Background="Transparent" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="♫" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#666666" />
                                <TextBlock Grid.Column="1" Text="推荐" VerticalAlignment="Center" FontSize="14" Foreground="#555555" />
                            </Grid>
                        </Border>
                        <!-- 排行榜 -->
                        <Border Height="44" CornerRadius="7" Background="Transparent" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="▣" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="#666666" />
                                <TextBlock Grid.Column="1" Text="排行榜" VerticalAlignment="Center" FontSize="14" Foreground="#555555" />
                            </Grid>
                        </Border>
                        <!-- 歌单 -->
                        <Border Height="44" CornerRadius="7" Background="Transparent" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="☷" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Foreground="#666666" />
                                <TextBlock Grid.Column="1" Text="歌单" VerticalAlignment="Center" FontSize="14" Foreground="#555555" />
                            </Grid>
                        </Border>
                        <!-- 视频 -->
                        <Border Height="44" CornerRadius="7" Background="Transparent" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#666666" />
                                <TextBlock Grid.Column="1" Text="视频" VerticalAlignment="Center" FontSize="14" Foreground="#555555" />
                            </Grid>
                        </Border>
                        <!-- 分组标题 -->
                        <TextBlock Text="我的音乐" Margin="16,24,0,10" FontSize="12" Foreground="#999999" />
                        <!-- 本地音乐 -->
                        <Border Height="44" CornerRadius="7" Background="Transparent" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="♪" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Foreground="#666666" />
                                <TextBlock Grid.Column="1" Text="本地音乐" VerticalAlignment="Center" FontSize="14" Foreground="#555555" />
                            </Grid>
                        </Border>
                        <!-- 最近播放 -->
                        <Border Height="44" CornerRadius="7" Background="Transparent" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="◷" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Foreground="#666666" />
                                <TextBlock Grid.Column="1" Text="最近播放" VerticalAlignment="Center" FontSize="14" Foreground="#555555" />
                            </Grid>
                        </Border>
                        <!-- 我喜欢的音乐 -->
                        <Border Height="44" CornerRadius="7" Background="Transparent" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="♡" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="#666666" />
                                <TextBlock Grid.Column="1" Text="我喜欢的音乐" VerticalAlignment="Center" FontSize="14" Foreground="#555555" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!--内容区-->
            <Border Grid.Column="1" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,24,30,24">
                        <TextBlock Text="推荐" FontSize="26" FontWeight="SemiBold" Foreground="#222222" Margin="0,0,0,20" />
                        <!-- Banner -->
                        <Border Height="180" CornerRadius="10" Background="#F3F3F3" ClipToBounds="True">
                            <Grid>
                                <!--Banner 图片占位-->
                                <Border Background="#EAEAEA">
                                    <TextBlock Text="Banner" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="#B5B5B5" />
                                </Border>
                                <!-- 左侧切换按钮 -->
                                <Button Width="32" Height="40" Background="#66000000" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="‹" FontSize="28" Foreground="White" />
                                </Button>
                                <!--右侧切换按钮-->
                                <Button Width="32" Height="40" Background="#66000000" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="›" FontSize="28" Foreground="White" />
                                </Button>
                                <!-- 底部指示点 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                    <Ellipse Width="7" Height="7" Fill="Black" Margin="3,0" />
                                    <Ellipse Width="7" Height="7" Fill="white" Margin="3,0" />
                                    <Ellipse Width="7" Height="7" Fill="white" Margin="3,0" />
                                    <Ellipse Width="7" Height="7" Fill="white" Margin="3,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- 热门歌单 -->
                        <TextBlock Text="热门歌单" FontSize="20" FontWeight="SemiBold" Foreground="#222222" Margin="0,30,0,20" />
                        <UniformGrid Columns="5" HorizontalAlignment="Stretch">
                            <!-- 卡片 1 -->
                            <StackPanel Margin="0,0,14,0">
                                <!-- 封面 -->
                                <Border Height="150" Background="#F2F2F2" CornerRadius="10" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="封面" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BBBBBB" FontSize="16" />
                                        <!-- 播放按钮 -->
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
                                            <TextBlock Text="▶" FontSize="13" Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <!-- 歌单名称 -->
                                <TextBlock Text="每日推荐歌单" Margin="2,10,2,0" FontSize="14" Foreground="#333333" TextTrimming="CharacterEllipsis" />
                                <!-- 播放量 -->
                                <TextBlock Text="12.5万次播放" Margin="2,4,0,0" FontSize="11" Foreground="#999999" />
                            </StackPanel>
                            <!-- 卡片 2 -->
                            <StackPanel Margin="0,0,14,0">
                                <Border Height="150" Background="#F2F2F2" CornerRadius="10" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="封面" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BBBBBB" FontSize="16" />
                                        <!-- 播放按钮 -->
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
                                            <TextBlock Text="▶" FontSize="13" Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="热门华语歌单" Margin="2,10,2,0" FontSize="14" Foreground="#333333" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="8.6万次播放" Margin="2,4,0,0" FontSize="11" Foreground="#999999" />
                            </StackPanel>
                            <!-- 卡片 3 -->
                            <StackPanel Margin="0,0,14,0">
                                <Border Height="150" Background="#F2F2F2" CornerRadius="10" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="封面" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BBBBBB" FontSize="16" />
                                        <!-- 播放按钮 -->
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
                                            <TextBlock Text="▶" FontSize="13" Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="流行音乐精选" Margin="2,10,2,0" FontSize="14" Foreground="#333333" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="6.2万次播放" Margin="2,4,0,0" FontSize="11" Foreground="#999999" />
                            </StackPanel>
                            <!-- 卡片 4 -->
                            <StackPanel Margin="0,0,14,0">
                                <Border Height="150" Background="#F2F2F2" CornerRadius="10" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="封面" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BBBBBB" FontSize="16" />
                                        <!-- 播放按钮 -->
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
                                            <TextBlock Text="▶" FontSize="13" Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="经典老歌合集" Margin="2,10,2,0" FontSize="14" Foreground="#333333" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="15.8万次播放" Margin="2,4,0,0" FontSize="11" Foreground="#999999" />
                            </StackPanel>
                            <!-- 卡片 5 -->
                            <StackPanel Margin="0,0,14,0">
                                <Border Height="150" Background="#F2F2F2" CornerRadius="10" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="封面" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BBBBBB" FontSize="16" />
                                        <!-- 播放按钮 -->
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
                                            <TextBlock Text="▶" FontSize="13" Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="新歌精选" Margin="2,10,2,0" FontSize="14" Foreground="#333333" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="4.9万次播放" Margin="2,4,0,0" FontSize="11" Foreground="#999999" />
                            </StackPanel>
                        </UniformGrid>
                        <!-- 热门歌曲标题 -->
                        <TextBlock Text="热门歌曲" FontSize="20" FontWeight="SemiBold" Foreground="#222222" Margin="0,30,0,16"/>
                        <!-- 热门歌曲列表 -->
                        <StackPanel>
                            <!-- 歌曲 1 -->
                            <Border Height="48" Background="Transparent" BorderBrush="#F2F2F2" BorderThickness="0,0,0,1" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- 鼠标悬停 -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F7F7F7"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 序号 -->
                                    <TextBlock Grid.Column="0" Text="01" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="#999999"/>
                                    <!-- 歌曲名称 -->
                                    <TextBlock Grid.Column="1" Text="晴天" VerticalAlignment="Center" FontSize="13" Foreground="#333333"/>
                                    <!-- 歌手 -->
                                    <TextBlock Grid.Column="2" Text="周杰伦" VerticalAlignment="Center" FontSize="12" Foreground="#999999"/>
                                    <!-- 操作区 -->
                                    <TextBlock Grid.Column="3" Text="•••" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="#999999"/>
                                </Grid>
                            </Border>
                            <!-- 歌曲 2 -->
                            <Border Height="48" Background="Transparent" CornerRadius="4" BorderBrush="#F2F2F2" BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- 鼠标悬停 -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F7F7F7"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="02" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="#999999"/>
                                    <TextBlock Grid.Column="1" Text="七里香" VerticalAlignment="Center" FontSize="13" Foreground="#333333"/>
                                    <TextBlock Grid.Column="2" Text="周杰伦" VerticalAlignment="Center" FontSize="12" Foreground="#999999"/>
                                    <TextBlock Grid.Column="3" Text="•••" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="#999999"/>
                                </Grid>
                            </Border>
                            <!-- 歌曲 3 -->
                            <Border Height="48" Background="Transparent" CornerRadius="4" BorderBrush="#F2F2F2" BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- 鼠标悬停 -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F7F7F7"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="03" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="#999999"/>
                                    <TextBlock Grid.Column="1" Text="青花瓷" VerticalAlignment="Center" FontSize="13" Foreground="#333333"/>
                                    <TextBlock Grid.Column="2" Text="周杰伦" VerticalAlignment="Center" FontSize="12" Foreground="#999999"/>
                                    <TextBlock Grid.Column="3" Text="•••" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="#999999"/>
                                </Grid>
                            </Border>
                            <!-- 歌曲 4 -->
                            <Border Height="48" Background="Transparent" CornerRadius="4" BorderBrush="#F2F2F2" BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- 鼠标悬停 -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F7F7F7"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="04" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="#999999"/>
                                    <TextBlock Grid.Column="1" Text="稻香" VerticalAlignment="Center" FontSize="13" Foreground="#333333"/>
                                    <TextBlock Grid.Column="2" Text="周杰伦" VerticalAlignment="Center" FontSize="12" Foreground="#999999"/>
                                    <TextBlock Grid.Column="3" Text="•••" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="#999999"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#F0F8FF" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- 歌曲封面 -->
                    <Border Width="52" Height="52" CornerRadius="6" Background="#F2F2F2" ClipToBounds="True">
                        <TextBlock Text="封面" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#AAAAAA" />
                    </Border>
                    <!-- 歌曲名称 -->
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="未播放歌曲" FontSize="13" Foreground="#333333" FontWeight="Medium" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="暂无歌手" Margin="0,6,0,0" FontSize="11" Foreground="#999999" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <!-- 播放控制 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 上一首 -->
                        <Button Width="36" Height="36" Background="Transparent" BorderThickness="0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder" Width="36" Height="36" CornerRadius="18" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 鼠标悬停 -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F2F2" />
                                        </Trigger>
                                        <!-- 鼠标按下 -->
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E5E5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid Width="14" Height="14">
                                <!-- 左三角 -->
                                <Path Data="M 2,7 L 8,2 L 8,12 Z" Fill="#555555"/>
                                <!-- 右三角 -->
                                <Path Data="M 8,7 L 14,2 L 14,12 Z" Fill="#555555"/>
                                <!-- 左侧竖线 -->
                                <Rectangle Width="2" Height="12" Fill="#555555" HorizontalAlignment="Left"/>
                            </Grid>
                        </Button>
                        <!-- 播放 -->
                        <Button Width="42" Height="42" Margin="10,0" Background="#F2F2F2" BorderThickness="0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Data="M 0,0 L 10,6 L 0,12 Z" Fill="#333333" Width="10" Height="12" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- 下一首 -->
                        <Button Width="36" Height="36" Background="Transparent" BorderThickness="0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder" Width="36" Height="36" CornerRadius="18" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 鼠标悬停 -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F2F2" />
                                        </Trigger>
                                        <!-- 鼠标按下 -->
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E5E5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid Width="14" Height="14">
                                <!-- 左三角 -->
                                <Path Data="M 0,2 L 6,7 L 0,12 Z" Fill="#555555"/>
                                <!-- 右三角 -->
                                <Path Data="M 6,2 L 12,7 L 6,12 Z" Fill="#555555"/>
                                <!-- 右侧竖线 -->
                                <Rectangle Width="2" Height="12" Fill="#555555" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="45,0,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>
                        <!-- 当前时间 -->
                        <TextBlock Grid.Column="0" Text="00:00" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#999999" />
                        <!-- 进度条 -->
                        <Slider Grid.Column="1" Value="30" Margin="6,0" Style="{StaticResource PlayerProgressBarStyle}" />
                        <!-- 总时间 -->
                        <TextBlock Grid.Column="2" Text="03:45" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#999999" />
                    </Grid>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Width="36" Height="36" Background="Transparent" BorderThickness="0" Content="🔊" FontSize="20" Foreground="#666666" />
                    <Slider Width="150" Value="50" Margin="8,0,0,0" Style="{StaticResource VolumeSliderStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>