                <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource SongRowButtonStyle}" Height="68" VerticalAlignment="Center" Command="{Binding TogglePlayerDetailCommand}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="8" Background="{Binding CurrentSong.AccentColor, FallbackValue=#DFE5EC}"><Grid><Image Source="{Binding CurrentSong.CoverImage}" Stretch="UniformToFill" /><Image Source="{Binding CurrentSong.CoverData, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="UniformToFill" /><TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding CurrentSong.SongName, FallbackValue=未播放歌曲}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue=从本地音乐开始聆听}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                </Button>

                <Grid Grid.Column="1" MaxWidth="590" HorizontalAlignment="Stretch" Margin="24,5">
                    <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="30" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Content="{Binding PlaybackModeGlyph}" FontSize="14" ToolTip="{Binding PlaybackModeTitle}" Command="{Binding CyclePlaybackModeCommand}" />
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE892;" FontSize="19" Margin="15,0,5,0" Command="{Binding PreviousSongCommand}" ToolTip="上一首" />
                        <Button Width="42" Height="42" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" Command="{Binding TogglePlayCommand}" Cursor="Hand">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="21"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE768;" /><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Text" Value="&#xE769;" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE893;" FontSize="19" Margin="5,0,15,0" Command="{Binding NextSongCommand}" ToolTip="下一首" />
                        <Button Style="{StaticResource IconButtonStyle}" Content="词" FontFamily="{StaticResource DefaultFont}" FontSize="12" FontWeight="SemiBold" ToolTip="桌面歌词" Click="DesktopLyricsButton_Click" />
                    </StackPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PositionText}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" /><Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource PlayerSliderStyle}" Value="{Binding ProgressPercent, Mode=OneWay}" PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp" /><TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE995;" ToolTip="音效" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE767;" ToolTip="静音/恢复音量" Command="{Binding ToggleMuteCommand}" />
                    <Slider Width="76" Style="{StaticResource PlayerSliderStyle}" Value="{Binding Volume, Mode=TwoWay}" Margin="-2,0,9,0" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8A5;" ToolTip="播放详情" Command="{Binding TogglePlayerDetailCommand}" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8FD;" ToolTip="播放队列" Command="{Binding ToggleQueueCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 播放队列 -->
        <Grid Grid.Row="1" Panel.ZIndex="30" Visibility="{Binding IsQueueOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#22000000" MouseLeftButtonDown="OverlayBackdrop_MouseLeftButtonDown" />
            <Border Width="366" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Padding="20,20,14,18">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock Text="当前播放" FontSize="19" FontWeight="SemiBold" /><Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE8BB;" Command="{Binding ToggleQueueCommand}" /></Grid><Grid Grid.Row="1" Margin="0,15,5,10"><TextBlock Text="{Binding QueueSongs.Count, StringFormat={}{0} 首歌曲}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" /><Button HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Height="28" Padding="12,0" Content="清空" Command="{Binding ClearQueueCommand}" /></Grid><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding QueueSongs}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="54" Margin="0,1,3,1"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="5" Background="{Binding AccentColor}"><TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" Foreground="#CFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding SongName}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplayArtist}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel><Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Content="&#xE711;" FontSize="11" Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
            </Border>
        </Grid>

        <!-- 播放详情 -->
        <Grid Grid.Row="1" Panel.ZIndex="35" Visibility="{Binding IsPlayerDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F3F8FD" /><GradientStop Color="#EDEAFB" Offset="0.55" /><GradientStop Color="#F9F4F7" Offset="1" /></LinearGradientBrush></Grid.Background>
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE70E;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,25,0" Command="{Binding TogglePlayerDetailCommand}" />
            <Grid Margin="72,34,72,25">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="290" Height="290" CornerRadius="145" Background="#1E1F2630" Padding="38">
                        <Border CornerRadius="107" Background="{Binding CurrentSong.AccentColor, FallbackValue=#7C8CAB}"><Grid><Ellipse Margin="20" Fill="#22000000" /><Ellipse Width="38" Height="38" Fill="#E9EDF2" /><TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="42" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border>
                    </Border>
                    <TextBlock Text="{Binding CurrentSong.SongName, FallbackValue=未播放歌曲}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,0" />
                    <TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue=导入本地音乐开始播放}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="430">
                    <TextBlock Text="歌词" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,26" />
                    <TextBlock Text="听见每一种热爱" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,12" />
                    <TextBlock Text="导入同名 LRC 文件后可显示同步歌词" FontSize="15" Foreground="#7C8390" HorizontalAlignment="Center" Margin="0,12" />
                    <TextBlock Text="让旋律陪你走过每个时刻" FontSize="15" Foreground="#A0A5AD" HorizontalAlignment="Center" Margin="0,12" />
                </StackPanel>
                <ListBox x:Name="LyricsList" Grid.Column="1" Width="470" Height="470" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Lyrics}" SelectedItem="{Binding CurrentLyricLine, Mode=OneWay}" SelectionChanged="LyricsList_SelectionChanged" Visibility="{Binding HasLyrics, Converter={StaticResource BooleanToVisibilityConverter}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="Padding" Value="8,11" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Focusable" Value="False" />
                            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /></Trigger></Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="15" /><Setter Property="Foreground" Value="#8B919B" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="FontSize" Value="21" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- 新建下载 -->
        <Grid Grid.Row="1" Panel.ZIndex="47" Visibility="{Binding IsDownloadEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#42000000" />
            <Border Width="470" Height="282" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect Color="#35000000" BlurRadius="24" ShadowDepth="6" /></Border.Effect><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="新建下载" FontSize="19" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Text="音频地址" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,20,0,6" /><TextBox Grid.Row="1" Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,40,0,0" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" /><StackPanel Grid.Row="2" Margin="0,17,0,0"><TextBlock Text="文件名（可选）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" /><TextBox Text="{Binding DownloadFileName, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" /></StackPanel><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Style="{StaticResource GhostButtonStyle}" Content="取消" Command="{Binding CancelDownloadEditorCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButtonStyle}" Content="开始下载" Command="{Binding StartDownloadCommand}" /></StackPanel></Grid></Border>
        </Grid>

        <!-- 本地歌单编辑器 -->
        <Grid Grid.Row="1" Panel.ZIndex="46" Visibility="{Binding IsPlaylistEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#42000000" />
            <Border Width="390" Height="210" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect Color="#35000000" BlurRadius="24" ShadowDepth="6" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding PlaylistEditorHeader}" FontSize="19" FontWeight="SemiBold" />
                    <TextBox Grid.Row="1" Text="{Binding PlaylistEditorTitle, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,22,0,0" Padding="12,0" VerticalContentAlignment="Center" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" FontSize="13" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Style="{StaticResource GhostButtonStyle}" Content="取消" Command="{Binding CancelPlaylistEditorCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButtonStyle}" Content="保存" Command="{Binding SavePlaylistEditorCommand}" /></StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 轻提示 -->
        <Border Grid.Row="1" Panel.ZIndex="50" Background="#E82A2D33" CornerRadius="9" Padding="17,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" />
        </Border>
    </Grid>
</Window>
