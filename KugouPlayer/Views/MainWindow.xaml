<Window x:Class="KugouPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:KugouPlayer.Models"
        x:Name="RootWindow"
        Title="酷狗音乐" Width="1140" Height="774"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource SurfaceBrush}" FontFamily="{StaticResource DefaultFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="NavItemTemplate">
            <RadioButton Style="{StaticResource NavButtonStyle}"
                         IsChecked="{Binding IsSelected}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding MenuName}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                </Grid>
            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="PlaylistCardTemplate">
            <Grid Width="174" Margin="0,0,16,0">
                <Grid.RowDefinitions><RowDefinition Height="148" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="{Binding AccentColor}" CornerRadius="12">
                    <Grid ClipToBounds="True">
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                        <Border Background="#26000000" />
                        <Ellipse Width="160" Height="160" Fill="#16FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-55,-70" />
                        <Ellipse Width="95" Height="95" Fill="#16FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-28,-30,0,0" />
                        <Border Width="50" Height="50" Background="#32FFFFFF" CornerRadius="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#58000000" CornerRadius="9" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White" Margin="0,0,4,0" /><TextBlock Text="{Binding PlayCount}" FontSize="10" Foreground="White" /></StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="2,10,2,0" />
                <TextBlock Grid.Row="2" Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="2,4,2,0" />
                <Button Grid.RowSpan="3" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" /></ControlTemplate></Button.Template></Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SongRowTemplate">
            <Button Style="{StaticResource SongRowButtonStyle}"
                    Command="{Binding DataContext.PlaySongCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" Background="{Binding AccentColor}" CornerRadius="6" HorizontalAlignment="Left"><Grid><Image Source="{Binding CoverImage}" Stretch="UniformToFill" /><Image Source="{Binding CoverData, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="UniformToFill" /><TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SongName}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <Border Background="#FFF2D8" CornerRadius="3" Padding="4,1" Margin="7,0,0,0"><TextBlock Text="SQ" FontSize="8" FontWeight="Bold" Foreground="#E5A331" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayArtist}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="LocalSongRowTemplate">
            <Grid Height="58">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource SongRowButtonStyle}" Command="{Binding DataContext.PlaySongCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{Binding AccentColor}" CornerRadius="6" HorizontalAlignment="Left"><Grid><Image Source="{Binding CoverData, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="UniformToFill" /><TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0"><TextBlock Text="{Binding SongName}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplayArtist}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE838;" FontSize="12" ToolTip="在资源管理器中显示" Command="{Binding DataContext.RevealLocalSongCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" FontSize="12" ToolTip="从资料库移除" Command="{Binding DataContext.RemoveLocalSongCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PageGridStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="86" /></Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="31" Height="31" Background="{DynamicResource PrimaryBrush}" CornerRadius="9">
                        <Grid><Ellipse Width="18" Height="18" Stroke="White" StrokeThickness="2.5" /><Ellipse Width="5" Height="5" Fill="White" /></Grid>
                    </Border>
                    <TextBlock Text="酷狗音乐" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="13,0,12,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72B;" ToolTip="返回首页" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.Home}" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" ToolTip="刷新" Margin="2,0,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Width="255" Height="34" CornerRadius="7" Background="{DynamicResource SurfaceMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalContentAlignment="Center" Padding="0">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}" /></TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Grid.Column="1" Text="搜索音乐、歌手、歌单" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Content="&#xE721;" FontSize="14" ToolTip="搜索" Command="{Binding SearchCommand}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0">
                    <Border Width="30" Height="30" CornerRadius="15" Background="#DCEBFA"><TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="点击登录" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="7,0,8,0" />
                    <Border Background="#FFF3E2" CornerRadius="10" Padding="7,3"><TextBlock Text="VIP" FontSize="9" FontWeight="Bold" Foreground="#F39A2E" /></Border>
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE713;" Margin="4,0,0,0" Command="{Binding ShowSettingsCommand}" ToolTip="设置" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE946;" Command="{Binding ShowAboutCommand}" ToolTip="关于与更新" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="MinimizeButton_Click" />
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="MaximizeButton_Click" />
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click">
                        <Button.Resources><Style TargetType="Border" /></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,13,0,18">
                        <ItemsControl ItemsSource="{Binding ExploreNavItems}" ItemTemplate="{StaticResource NavItemTemplate}" />
                        <TextBlock Text="我的音乐" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="22,24,0,8" />
                        <ItemsControl ItemsSource="{Binding MyMusicNavItems}" ItemTemplate="{StaticResource NavItemTemplate}" />
                        <Grid Margin="16,22,16,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="创建的歌单" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Content="&#xE710;" FontSize="11" ToolTip="新建歌单" Command="{Binding BeginCreatePlaylistCommand}" />
                        </Grid>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Margin="10,6,10,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="&#xE8D5;" FontFamily="{StaticResource IconFont}" FontSize="15" /><TextBlock Grid.Column="1" Text="默认收藏" FontSize="13" /></Grid>
                        </RadioButton>
                        <ItemsControl ItemsSource="{Binding UserPlaylists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource NavButtonStyle}" Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="&#xE8D5;" FontFamily="{StaticResource IconFont}" FontSize="15" /><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" /></Grid>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
                <Border Height="52" VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Panel.ZIndex="12">
                    <Grid Margin="26,0,24,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <RadioButton Content="推荐" GroupName="ContentChannel" IsChecked="True" Style="{StaticResource TopTabStyle}" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.Home}" />
                            <RadioButton Content="乐库" GroupName="ContentChannel" Style="{StaticResource TopTabStyle}" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.MusicLibrary}" />
                            <RadioButton Content="歌单" GroupName="ContentChannel" Style="{StaticResource TopTabStyle}" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.Playlists}" />
                            <RadioButton Content="频道" GroupName="ContentChannel" Style="{StaticResource TopTabStyle}" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.Radio}" />
                            <RadioButton Content="分类" GroupName="ContentChannel" Style="{StaticResource TopTabStyle}" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.Charts}" />
                            <RadioButton Content="视频" GroupName="ContentChannel" Style="{StaticResource TopTabStyle}" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.Videos}" />
                            <RadioButton Content="AI帮唱" GroupName="ContentChannel" Style="{StaticResource TopTabStyle}" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.Audiobooks}" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="14" Padding="12,6"><TextBlock Text="听歌识曲  ♫" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                    </Grid>
                </Border>
                <!-- 首页 -->
                <Grid Margin="0,52,0,0">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PageGridStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:PageKind.Home}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="30,25,30,34" MaxWidth="1120">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Hi，欢迎回来" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="从一首喜欢的歌开始今天" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="1,7,0,0" /></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource GhostButtonStyle}" Content="播放历史" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.Recent}" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButtonStyle}" Content="导入本地音乐" Command="{Binding ImportLocalMusicCommand}" /></StackPanel>
                            </Grid>

                            <Grid Margin="0,24,0,0" Height="176">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <Border CornerRadius="15" Margin="0,0,12,0">
                                    <Grid ClipToBounds="True">
                                        <Image Source="/Assets/hero-listening.png" Stretch="UniformToFill" />
                                        <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#D5162F65" /><GradientStop Color="#702B4D91" Offset="0.55" /><GradientStop Color="#001C2A52" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel Margin="28,25" VerticalAlignment="Center"><TextBlock Text="每日推荐" FontSize="13" Foreground="#DFFFFFFF" /><TextBlock Text="发现今天的心动旋律" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,9,0,0" /><TextBlock Text="根据你的音乐偏好更新 · 30首" FontSize="11" Foreground="#BFFFFFFF" Margin="0,8,0,17" /><Button Width="104" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" Background="White" Foreground="#4E72EC" Content="▶ 立即播放" /></StackPanel>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource SongRowButtonStyle}" Height="176" Margin="0,0,12,0" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.Charts}">
                                    <Border Background="#FFF4EA" CornerRadius="15"><Grid><StackPanel Margin="20" VerticalAlignment="Bottom"><Border Width="42" Height="42" CornerRadius="12" Background="#FFDFC0" HorizontalAlignment="Left"><TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" Foreground="#F39A3B" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="排行榜" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" /><TextBlock Text="全网热歌实时更新" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,5,0,0" /></StackPanel></Grid></Border>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource SongRowButtonStyle}" Height="176" Command="{Binding NavigateToPageCommand}" CommandParameter="{x:Static models:PageKind.Radio}">
                                    <Border Background="#EAF8F5" CornerRadius="15"><StackPanel Margin="20" VerticalAlignment="Bottom"><Border Width="42" Height="42" CornerRadius="12" Background="#CCDFD8" HorizontalAlignment="Left"><TextBlock Text="&#xE789;" FontFamily="{StaticResource IconFont}" Foreground="#1FA686" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="私人电台" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" /><TextBlock Text="越听越懂你的频道" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,5,0,0" /></StackPanel></Border>
                                </Button>
                            </Grid>

                            <Grid Margin="0,31,0,16"><TextBlock Text="你的专属歌单" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="查看更多  ›" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            <ItemsControl ItemsSource="{Binding RecommendedPlaylists}" ItemTemplate="{StaticResource PlaylistCardTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Grid Margin="0,34,0,9"><TextBlock Text="大家都在听" FontSize="19" FontWeight="SemiBold" /><Button HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Height="30" Padding="13,0" Content="播放全部" /></Grid>
                            <ItemsControl ItemsSource="{Binding FeaturedSongs}" ItemTemplate="{StaticResource SongRowTemplate}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 公共内容页 -->
                <Grid Margin="0,52,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PageGridStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:PageKind.MusicLibrary}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:PageKind.Playlists}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:PageKind.Charts}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:PageKind.Radio}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:PageKind.Videos}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:PageKind.Audiobooks}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,27,32,34">
                            <Grid>
                                <StackPanel><TextBlock Text="{Binding CurrentPageTitle}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentExploreDescription}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,7,0,0" /></StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource GhostButtonStyle}" Content="播放本地视频" Click="OpenLocalVideoButton_Click" Margin="0,0,8,0" Visibility="{Binding IsVideoPage, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Style="{StaticResource PrimaryButtonStyle}" Content="＋ 新建歌单" Command="{Binding BeginCreatePlaylistCommand}" Visibility="{Binding IsPlaylistPage, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ExploreCategories}" Margin="0,18,0,24"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.SelectExploreCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButtonStyle}" Background="{DynamicResource SurfaceMutedBrush}" Margin="0,0,8,0" Padding="15,0" Height="32" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <ItemsControl ItemsSource="{Binding VisibleExplorePlaylists}" ItemTemplate="{StaticResource PlaylistCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                            <TextBlock Text="热门内容" FontSize="19" FontWeight="SemiBold" Margin="0,28,0,10" />
                            <ItemsControl ItemsSource="{Binding FeaturedSongs}" ItemTemplate="{StaticResource SongRowTemplate}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Background="{DynamicResource SurfaceBrush}" Padding="32,27" Visibility="{Binding IsPlaylistDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72B;" HorizontalAlignment="Left" Command="{Binding ClosePlaylistDetailCommand}" ToolTip="返回歌单" />
                            <Grid Grid.Row="1" Margin="0,18,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="174" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="164" Height="164" CornerRadius="12" Background="{Binding SelectedPlaylist.AccentColor}" HorizontalAlignment="Left"><Image Source="{Binding SelectedPlaylist.CoverImage}" Stretch="UniformToFill" /></Border>
                                <StackPanel Grid.Column="1" Margin="22,7,0,0"><Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="4" Padding="7,3" HorizontalAlignment="Left"><TextBlock Text="歌单" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" /></Border><TextBlock Text="{Binding SelectedPlaylist.Title}" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="{Binding SelectedPlaylist.Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" /><TextBlock Text="{Binding SelectedPlaylist.PlayCount, StringFormat=累计播放 {0} 次}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,16" /><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButtonStyle}" Content="▶ 播放全部" Command="{Binding PlayPlaylistCommand}" CommandParameter="{Binding SelectedPlaylist}" Margin="0,0,8,0" /><Button Content="＋ 收藏歌单" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPlaylist.IsUserCreated}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Style="{StaticResource GhostButtonStyle}" Content="加入当前歌曲" Command="{Binding AddCurrentSongToSelectedPlaylistCommand}" Margin="0,0,8,0" Visibility="{Binding SelectedPlaylist.IsUserCreated, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Style="{StaticResource GhostButtonStyle}" Content="重命名" Command="{Binding BeginRenamePlaylistCommand}" CommandParameter="{Binding SelectedPlaylist}" Margin="0,0,8,0" Visibility="{Binding SelectedPlaylist.IsUserCreated, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Style="{StaticResource GhostButtonStyle}" Foreground="#E05252" Content="删除" Command="{Binding DeletePlaylistCommand}" CommandParameter="{Binding SelectedPlaylist}" Visibility="{Binding SelectedPlaylist.IsUserCreated, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></StackPanel>
                            </Grid>
