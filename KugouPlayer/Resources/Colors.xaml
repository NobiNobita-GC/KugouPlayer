<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="KugouPrimary">#168CFA</Color>
    <Color x:Key="KugouPrimaryDark">#0879E8</Color>
    <Color x:Key="KugouPrimaryLight">#EAF5FF</Color>
    <Color x:Key="WindowBackgroundColor">#F6F8FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceMutedColor">#F1F4F8</Color>
    <Color x:Key="TextPrimaryColor">#171A21</Color>
    <Color x:Key="TextSecondaryColor">#656B76</Color>
    <Color x:Key="TextTertiaryColor">#9AA0AA</Color>
    <Color x:Key="DividerColor">#E9ECF1</Color>
    <Color x:Key="ControlHoverColor">#EDF2F7</Color>
    <Color x:Key="ControlPressedColor">#E2E9F0</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource KugouPrimary}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource KugouPrimaryDark}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource KugouPrimaryLight}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />

    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="SmallRadius">7</CornerRadius>
    <FontFamily x:Key="DefaultFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
