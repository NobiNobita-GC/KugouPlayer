<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">    <!-- 酷狗主题色 -->    <Color x:Key="KugouPrimary">#4285F4</Color>    <Color x:Key="KugouLightBlue">#E8F0FE</Color>    <Color x:Key="KugouGrayBg">#F5F7FA</Color>    <Color x:Key="KugouTextGray">#666666</Color>    <Color x:Key="KugouBorder">#E0E0E0</Color>    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource KugouPrimary}"/>    <SolidColorBrush x:Key="LightBlueBrush" Color="{StaticResource KugouLightBlue}"/>    <SolidColorBrush x:Key="GrayBgBrush" Color="{StaticResource KugouGrayBg}"/>    <SolidColorBrush x:Key="TextGrayBrush" Color="{StaticResource KugouTextGray}"/>    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource KugouBorder}"/>    <!-- 通用圆角模板 -->    <CornerRadius x:Key="CardRadius">8</CornerRadius>    <CornerRadius x:Key="SmallRadius">4</CornerRadius>    <!-- 字体 -->    <FontFamily x:Key="DefaultFont">Microsoft YaHei</FontFamily></ResourceDictionary>